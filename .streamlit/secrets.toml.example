# =====================================================================
# secrets.toml.example
# 複製此檔為 .streamlit/secrets.toml 填入真實憑證（本地開發用）
# Streamlit Cloud 部署：在 App Settings → Secrets 填入相同 key/value
# ⚠️  secrets.toml 已加入 .gitignore，絕不提交真實憑證
# =====================================================================

# ── 帳戶 ACC001 ──────────────────────────────────────────────────────
ALPACA_KEY_ACC001    = "your_paper_api_key_here"
ALPACA_SECRET_ACC001 = "your_paper_api_secret_here"

# ── 帳戶 ACC002（若有第二帳戶）──────────────────────────────────────
# ALPACA_KEY_ACC002    = "your_second_key_here"
# ALPACA_SECRET_ACC002 = "your_second_secret_here"

# ── Alpaca API 端點 ──────────────────────────────────────────────────
ALPACA_BASE_URL = "https://paper-api.alpaca.markets/v2"
ALPACA_DATA_URL = "https://data.alpaca.markets/v2"
